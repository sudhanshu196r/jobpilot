# Copy to .env and adjust. Everything here is optional.

# Claude API key for AI parsing/tailoring (can also be set in Settings).
ANTHROPIC_API_KEY=

# Where the database and generated resumes live (default: ./data).
# JOBPILOT_DATA_DIR=./data

# Bind address. Keep 127.0.0.1 so only this computer can reach JobPilot.
# JOBPILOT_HOST=127.0.0.1
# JOBPILOT_PORT=8765
