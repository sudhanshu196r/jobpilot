{
  "manifest_version": 3,
  "name": "JobPilot",
  "version": "1.0.0",
  "description": "Captures jobs from Naukri and Indeed into your local JobPilot, shows match scores, and fills application forms with your tailored resume.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "JobPilot" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "tabs", "scripting", "activeTab"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.naukri.com/*",
    "https://*.indeed.com/*",
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://apply.workable.com/*",
    "https://jobs.smartrecruiters.com/*",
    "https://*.icims.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.naukri.com/*"],
      "js": ["content/common.js", "content/naukri.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.indeed.com/*"],
      "exclude_matches": ["https://smartapply.indeed.com/*"],
      "js": ["content/common.js", "content/indeed.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://smartapply.indeed.com/*",
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://apply.workable.com/*",
        "https://jobs.smartrecruiters.com/*",
        "https://*.icims.com/*"
      ],
      "js": ["content/common.js", "content/ats.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
